generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  BRAND
}

enum RolStatus {
  MENUNGGU_FISIK
  DI_GUDANG
  DIPROSES
  SELESAI
}

enum SpkStatus {
  DRAFT
  IN_PRODUCTION
  PARTIAL_DELIVERED
  COMPLETED
  OVER_DELIVERY
  CANCELLED
}

enum KasbonTipe {
  PINJAMAN
  PELUNASAN
}

enum MetodePembayaran {
  TRANSFER
  TUNAI
  CEK
  GIRO
}

enum ReturnStatus {
  DIAJUKAN
  DIKIRIM_KE_VENDOR
  SELESAI_REWORK
  REJECT_TOTAL
}

enum ReturnSource {
  INTERNAL_QC
  BRAND_COMPLAINT
}

model Brand {
  id             String  @id @default(cuid())
  name           String  @unique
  code           String  @unique
  contactPerson  String?
  phone          String?
  supabaseUid    String? @unique

  inboundRolls   InboundRoll[]
  spkList        SpkCutting[]
  suratJalanList SuratJalan[]
  pembayaranList PembayaranBrand[]
  hargaBuyer     HargaBuyer[]
  returnList     ReturnItem[]
  productSKUs    BrandProductSKU[]
  sales          BrandSale[]
  stockExits     BrandStockExit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id           String  @id @default(cuid())
  name         String  @unique
  specialty    String?
  contact      String?

  hargaKonveksi    HargaKonveksi[]
  spkList          SpkCutting[]
  kasbonList       KasbonTransaction[]
  returnList       ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HargaKonveksi {
  id      String  @id @default(cuid())
  vendor  String
  brand   String
  produk  String
  harga   Decimal @db.Decimal(12, 2)

  vendorRef Vendor @relation(fields: [vendor], references: [name], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendor, brand, produk])
}

model HargaBuyer {
  id           String  @id @default(cuid())
  brand        String
  produk       String
  rateS        Decimal @db.Decimal(12, 2) @default(0)
  rateM        Decimal @db.Decimal(12, 2) @default(0)
  rateL        Decimal @db.Decimal(12, 2) @default(0)
  rateXL       Decimal @db.Decimal(12, 2) @default(0)
  rateXXL      Decimal @db.Decimal(12, 2) @default(0)
  rateSML      Decimal @db.Decimal(12, 2) @default(0)
  rateAnak4    Decimal @db.Decimal(12, 2) @default(0)
  rateAnak6    Decimal @db.Decimal(12, 2) @default(0)
  rateAnak8    Decimal @db.Decimal(12, 2) @default(0)
  rateAnak10   Decimal @db.Decimal(12, 2) @default(0)
  rateAnak12   Decimal @db.Decimal(12, 2) @default(0)
  rateAnak14   Decimal @db.Decimal(12, 2) @default(0)
  rateAnak16   Decimal @db.Decimal(12, 2) @default(0)

  brandRef Brand @relation(fields: [brand], references: [name], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brand, produk])
}

model InboundRoll {
  id              String    @id @default(cuid())
  rollCode        String    @unique
  brand           String
  jenisKain       String
  meterLength     Decimal   @db.Decimal(8, 2)
  meterUsed       Decimal   @db.Decimal(8, 2) @default(0)
  hargaModalMeter Decimal   @db.Decimal(12, 2)
  status          RolStatus @default(DI_GUDANG)
  tanggalMasuk    DateTime
  keterangan      String?

  brandRef  Brand    @relation(fields: [brand], references: [name])
  spkRols   SpkRol[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpkCutting {
  id            String    @id @default(cuid())
  spkNumber     String    @unique
  brand         String
  produk        String
  vendor        String
  status        SpkStatus @default(DRAFT)
  tanggalSPK    DateTime
  targetSelesai DateTime?
  catatan       String?

  targetS       Int @default(0)
  targetM       Int @default(0)
  targetL       Int @default(0)
  targetXL      Int @default(0)
  targetXXL     Int @default(0)
  targetAnak4   Int @default(0)
  targetAnak6   Int @default(0)
  targetAnak8   Int @default(0)
  targetAnak10  Int @default(0)
  targetAnak12  Int @default(0)
  targetAnak14  Int @default(0)
  targetAnak16  Int @default(0)

  deliveredS       Int @default(0)
  deliveredM       Int @default(0)
  deliveredL       Int @default(0)
  deliveredXL      Int @default(0)
  deliveredXXL     Int @default(0)
  deliveredAnak4   Int @default(0)
  deliveredAnak6   Int @default(0)
  deliveredAnak8   Int @default(0)
  deliveredAnak10  Int @default(0)
  deliveredAnak12  Int @default(0)
  deliveredAnak14  Int @default(0)
  deliveredAnak16  Int @default(0)

  brandRef       Brand        @relation(fields: [brand], references: [name])
  vendorRef      Vendor       @relation(fields: [vendor], references: [name])
  rolsDigunakan  SpkRol[]
  suratJalanList SuratJalan[]
  returnList     ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpkRol {
  spkId String
  rolId String

  spk SpkCutting  @relation(fields: [spkId], references: [id], onDelete: Cascade)
  rol InboundRoll @relation(fields: [rolId], references: [id])

  @@id([spkId, rolId])
}

model SuratJalan {
  id            String   @id @default(cuid())
  noSuratJalan  String   @unique
  spkId         String
  brand         String
  produk        String
  vendor        String
  tanggal       DateTime
  driverName    String?
  nomorKendaraan String?
  catatan       String?
  status        String   @default("DELIVERED")

  items         Json?

  qtySML        Int @default(0)
  qtyM          Int @default(0)
  qtyL          Int @default(0)
  qtyXL         Int @default(0)
  qtyXXL        Int @default(0)
  qtyAnak4      Int @default(0)
  qtyAnak6      Int @default(0)
  qtyAnak8      Int @default(0)
  qtyAnak10     Int @default(0)
  qtyAnak12     Int @default(0)
  qtyAnak14     Int @default(0)
  qtyAnak16     Int @default(0)
  totalPcs      Int @default(0)

  spk        SpkCutting   @relation(fields: [spkId], references: [id])
  brandRef   Brand        @relation(fields: [brand], references: [name])
  returnList ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReturnItem {
  id             String       @id @default(cuid())
  noRetur        String       @unique
  sumber         ReturnSource @default(INTERNAL_QC)
  spkId          String?
  suratJalanId   String?
  brand          String
  produk         String
  vendor         String
  tanggalRetur   DateTime
  tanggalSelesai DateTime?
  alasanCacat    String
  kategoriCacat  String       @default("JAHITAN")
  catatan        String?
  status         ReturnStatus @default(DIAJUKAN)

  qtyS           Int          @default(0)
  qtyM           Int          @default(0)
  qtyL           Int          @default(0)
  qtyXL          Int          @default(0)
  qtyXXL         Int          @default(0)
  qtyAnak4       Int          @default(0)
  qtyAnak6       Int          @default(0)
  qtyAnak8       Int          @default(0)
  qtyAnak10      Int          @default(0)
  qtyAnak12      Int          @default(0)
  qtyAnak14      Int          @default(0)
  qtyAnak16      Int          @default(0)
  totalPcs       Int          @default(0)

  qtyReworked    Int          @default(0)
  qtyRejectTotal Int          @default(0)

  brandRef       Brand        @relation(fields: [brand], references: [name])
  vendorRef      Vendor       @relation(fields: [vendor], references: [name])
  spk            SpkCutting?  @relation(fields: [spkId], references: [id])
  suratJalan     SuratJalan?  @relation(fields: [suratJalanId], references: [id])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model KasbonTransaction {
  id         String     @id @default(cuid())
  vendor     String
  tanggal    DateTime
  jumlah     Decimal    @db.Decimal(12, 2)
  tipe       KasbonTipe @default(PINJAMAN)
  keterangan String

  vendorRef Vendor @relation(fields: [vendor], references: [name])

  createdAt DateTime @default(now())
}

model PembayaranBrand {
  id             String           @id @default(cuid())
  brand          String
  tanggal        DateTime
  jumlah         Decimal          @db.Decimal(14, 2)
  metode         MetodePembayaran
  keterangan     String
  referensiNomor String?

  brandRef Brand @relation(fields: [brand], references: [name])

  createdAt DateTime @default(now())
}

enum UserStatus {
  ACTIVE
  PENDING_APPROVAL
  REJECTED
}

model User {
  id               String      @id @default(cuid())
  name             String
  email            String      @unique
  password         String
  phone            String?
  role             UserRole    @default(BRAND)
  status           UserStatus  @default(PENDING_APPROVAL)
  accessibleBrands String[]    @default([])
  brandName        String?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Accessory {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  category    String   @default("KANCING")
  brand       String?  @default("UMUM")
  unit        String   @default("PCS")
  stock       Decimal  @db.Decimal(12, 2) @default(0)
  safetyStock Decimal  @db.Decimal(12, 2) @default(10)
  location    String?
  costPerUnit Decimal? @db.Decimal(12, 2) @default(0)
  notes       String?

  mutations   AccessoryMutation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AccessoryMutation {
  id                  String   @id @default(cuid())
  accessoryId         String
  accessoryName       String
  sku                 String
  type                String
  quantity            Decimal  @db.Decimal(12, 2)
  unit                String
  date                DateTime
  sourceOrDestination String?
  spkId               String?
  spkNumber           String?
  recipientOrVendor   String?
  notes               String?
  costTotal           Decimal? @db.Decimal(14, 2)

  accessory           Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
}


model BrandProductSKU {
  id         String   @id @default(cuid())
  brand      String
  produk     String
  sku        String
  warna      String?
  ukuran     String?
  hpp        Decimal  @db.Decimal(12, 2)
  stokAwal   Int      @default(0)
  catatan    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brandRef   Brand    @relation(fields: [brand], references: [name])
  sales      BrandSale[]
  stockExits BrandStockExit[]

  @@unique([brand, sku])
}

model BrandSale {
  id               String           @id @default(cuid())
  brand            String
  tanggal          DateTime
  marketplace      String           // SHOPEE, TIKTOK, TOKOPEDIA, OFFLINE, LAINNYA
  toko             String?
  noPesanan        String?
  username         String?
  skuId            String?
  sku              String
  qty              Int              @default(1)
  hpp              Decimal          @db.Decimal(12, 2)
  omset            Decimal          @db.Decimal(14, 2)
  biayaIklan       Decimal          @default(0) @db.Decimal(12, 2)
  biayaOperasional Decimal          @default(0) @db.Decimal(12, 2)
  estimasiProfit   Decimal          @db.Decimal(14, 2)
  catatan          String?
  createdAt        DateTime         @default(now())

  brandRef         Brand            @relation(fields: [brand], references: [name])
  skuRef           BrandProductSKU? @relation(fields: [skuId], references: [id], onDelete: SetNull)
}

model BrandStockExit {
  id         String           @id @default(cuid())
  brand      String
  tanggal    DateTime
  skuId      String?
  sku        String
  qty        Int              @default(1)
  kategori   String           // SAMPLE_FOTO, ENDORSEMENT, REJECT_RUSAK, GIFT_BONUS, LAINNYA
  keterangan String?
  createdAt  DateTime         @default(now())

  brandRef   Brand            @relation(fields: [brand], references: [name])
  skuRef     BrandProductSKU? @relation(fields: [skuId], references: [id], onDelete: SetNull)
}

model ProductionPO {
  id             String             @id @default(cuid())
  noPO           String             @unique
  brand          String
  vendorTujuan   String
  tanggalPO      DateTime
  targetDeadline DateTime
  catatan        String?
  status         String             @default("DRAFT")
  totalPcs       Int                @default(0)
  items          ProductionPOItem[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model ProductionPOItem {
  id           String       @id @default(cuid())
  poId         String
  namaProduk   String
  warna        String?
  ukuran       String?
  qty          Int          @default(1)
  bahanKain    String?
  catatan      String?

  po           ProductionPO @relation(fields: [poId], references: [id], onDelete: Cascade)

  createdAt    DateTime     @default(now())
}
